FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    object      pointDisplacement;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    overset
    {
        patchType       overset;
        type            zeroGradient;
    }

    // Cylinder wall
    cylinderWall
    {
	//patchType       overset;
        //type            zeroGradient;
        
        type calculated;  // No need to prescribe it manually
        value uniform (0 0 0);
    }
    
    
     cylinderFrontAndBack
    {
        type            empty;
    }

    frontAndBack
    {
        type            empty;
    }


    // Outside patches
    ".*"
    {
        type            uniformFixedValue;
        uniformValue    (0 0 0);
    }
}


